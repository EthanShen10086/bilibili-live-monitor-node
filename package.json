{
  "name": "bilibili-live-monitor-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:vendor": "tsc -p vendor/bilibili-live-ws/tsconfig.json",
    "build": "npm run build:vendor && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "monitor": "node dist/src/cli.js",
    "test:live": "npm run build && MONITOR_LIVE_TEST=1 node --test dist/test/live.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "bilibili-live-ws": "file:vendor/bilibili-live-ws",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/pako": "^2.0.4",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
